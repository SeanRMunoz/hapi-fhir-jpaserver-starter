# Clerk environment variables
# Obtain from https://dashboard.clerk.com/ for your project
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: set the base URL when deploying
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# n8n agent endpoint configuration
# The API route /api/patient-query will POST to this URL with JSON { prompt }
# Example: http://localhost:5678/webhook/patient-agent
N8N_AGENT_URL=
